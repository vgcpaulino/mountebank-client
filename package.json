{
    "name": "mountebank-client",
    "version": "1.0.2",
    "description": "A TypeScript Client for Mountebank API",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        },
        "./server": {
            "types": "./dist/server/index.d.ts",
            "default": "./dist/server/index.js"
        },
        "./jest": {
            "types": "./dist/testing/jest.d.ts",
            "default": "./dist/testing/jest.js"
        },
        "./playwright": {
            "types": "./dist/testing/playwright.d.ts",
            "default": "./dist/testing/playwright.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "skills",
        "LICENSE",
        "README.md"
    ],
    "scripts": {
        "test": "jest --config jest.config.js",
        "test:unit": "jest --config jest.config.js --selectProjects unit",
        "test:integration": "jest --config jest.config.js --selectProjects integration",
        "test:playwright": "playwright test --config tests/playwright/playwright.config.ts",
        "test:list": "jest --config jest.config.js --listTests",
        "start": "ts-node-dev --files ./scripts/start-mountebank.ts",
        "start:dev": "ts-node-dev --files ./examples/users-service/main.ts",
        "build": "npm run clean && tsc",
        "prepare": "npm run build",
        "format": "prettier --write \"{src,tests,scripts,examples/users-service}/**/*.ts\"",
        "format:check": "prettier --check \"{src,tests,scripts,examples/users-service}/**/*.ts\"",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "example": "ts-node --files ./examples/dev.ts",
        "example:prod": "tsc && node ./dist/examples/dev.js",
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
        "pre:publish": "npm run clean && npm test && npm run build",
        "pack": "npm pack",
        "test:pack-install": "cd pack-install && npm install",
        "test:pack-run": "cd pack-install && node test.js"
    },
    "keywords": [
        "mountebank",
        "api",
        "mock",
        "test",
        "stub",
        "typescript"
    ],
    "author": "Vinicius Gabriel Cabral Paulino",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vgcpaulino/mountebank-client.git"
    },
    "homepage": "https://github.com/vgcpaulino/mountebank-client#readme",
    "bugs": {
        "url": "https://github.com/vgcpaulino/mountebank-client/issues"
    },
    "license": "MIT",
    "engines": {
        "node": ">=20.19"
    },
    "devDependencies": {
        "@eslint/js": "^10",
        "@mbtest/mountebank": "^2.9.5",
        "@playwright/test": "^1.42.1",
        "@types/jest": "^29.5.0",
        "@types/node": "^20",
        "eslint": "^10",
        "eslint-config-prettier": "^10",
        "globals": "^17.14.0",
        "jest": "^29.5.0",
        "mb-graphql": "^0.1.11",
        "prettier": "^2.8.7",
        "ts-jest": "^29.4.15",
        "ts-node": "^10.8.2",
        "ts-node-dev": "^2.0.0",
        "typescript": "6.0.3",
        "typescript-eslint": "^8.72.2"
    },
    "peerDependencies": {
        "@mbtest/mountebank": "^2.9.5",
        "mb-graphql": "^0.1.11"
    },
    "peerDependenciesMeta": {
        "@mbtest/mountebank": {
            "optional": true
        },
        "mb-graphql": {
            "optional": true
        }
    }
}
